clear
clc
close all

filename = 'Hoosier_LCO_16.0x7.5-10_FY_10psi';
load(filename)
IA = 1;
delta = 0;
results = [];
sf_y = 1e-7;



for sa = 0:12
    for fz = 0:300
        fy = fnval(full_send_y,{rad2deg(sa) -fz -rad2deg(IA)})*sf_y*cos(delta);
        results = [results; sa,fz,fy];
    end
end

figure
plot3(results(:,1),results(:,2),abs(results(:,3)),'.')
xlabel('Slip Angle [deg]')
ylabel('Normal Load (Fz) [lb]')
zlabel('Absolute Lateral Force (abs(Fy)) [lb]')
hold on

filename = 'Hoosier R20 16x7.5-10 12 Psi Final FY';
load(filename)
results = [];



for sa = 0:15
    for fz = 0:300
        fy = fnval(full_send_y,{rad2deg(sa) -fz -rad2deg(IA)})*sf_y*cos(delta);
        results = [results; sa,fz,fy];
    end
end

plot3(results(:,1),results(:,2),abs(results(:,3)),'.')
hold off
legend({'LC0','R20'},'FontSize',16)
%zlim([-1000,1000])

